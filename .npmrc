# RA-09: make the shipped runtime floor an install-time fact, not a README sentence.
#
# The 2026-10-09 re-audit added jsdom@30 for the new component render suite. Its
# declared engines are `^22.22.2 || ^24.15.0 || >=26.0.0`, so it cannot run on the
# Node 20 that the Dockerfile pins (node:20-alpine3.20, measured 20.20.2) and that CI
# uses - but npm only *warns* about engines by default, so `npm ci` completed and the
# suite died later with "webidl.util.markAsUncloneable is not a function" inside CI's
# forked worker. A development-only dependency that cannot load on the production
# runtime is a defect in the toolchain, and the pinned base image cannot move at a
# release cut to accommodate it.
#
# engine-strict turns that into a refusal at install time, on every machine, with the
# package and the range in the message. package.json's own "engines" mirrors the
# narrowest floor in the stack (prisma 7 requires ^20.19 || ^22.12 || >=24).
engine-strict=true
