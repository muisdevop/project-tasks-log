{
  "name": "project-tasks-log",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run lint && npm run typecheck && vitest run",
    "test:unit": "vitest run --exclude tests/integration/**",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "bundle:budget": "node scripts/measure-bundle.mjs",
    "db:generate": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:generate:sqlite": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:generate:postgres": "prisma generate --schema prisma/postgres/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.sqlite.prisma",
    "db:migrate:sqlite": "prisma migrate dev --schema prisma/schema.sqlite.prisma",
    "db:migrate:postgres": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:migrate:dev:postgres": "prisma migrate dev --schema prisma/postgres/schema.prisma",
    "db:migrate:sqlite-to-postgres": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "db:parity": "node scripts/check-schema-parity.mjs",
    "password:hash": "tsx scripts/hash-password.ts",
    "docs:openapi": "tsx scripts/generate-openapi.ts",
    "docs:openapi:check": "tsx scripts/generate-openapi.ts --check",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium webkit firefox"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.5.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-link": "^3.20.5",
    "@tiptap/extension-underline": "^3.21.0",
    "@tiptap/react": "^3.20.5",
    "@tiptap/starter-kit": "^3.20.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "isomorphic-dompurify": "^3.19.0",
    "jose": "^6.2.2",
    "next": "^16.4.0",
    "pg": "^8.13.3",
    "prisma": "^7.5.0",
    "puppeteer": "^24.40.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
