# ---------------------------------------------------------------------------
# GID Task Flow — environment template
# Copy to `.env` for local development. Production values are validated at
# startup (src/instrumentation.ts -> src/lib/startup-checks.ts): in production
# the process refuses to boot with a short/known-default SESSION_SECRET or with
# a plaintext APP_PASSWORD.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# SQLite is the default. Keep DATABASE_URL as a `file:` URL for SQLite and a
# `postgresql://` URL for Postgres; the app fails fast on a mismatch (ST-03)
# rather than silently opening an empty database.
DATABASE_URL="file:./dev.db"

# Optional explicit provider hint ("sqlite" | "postgres"). When unset it is
# inferred from DATABASE_URL / PRISMA_SCHEMA_PATH.
# DB_PROVIDER="sqlite"

# Provider-specific fallbacks used when DATABASE_URL is not set.
# DATABASE_URL_SQLITE="file:./dev.db"
# DATABASE_URL_POSTGRES="postgresql://postgres:postgres@localhost:5400/postgres?schema=public"

# Which Prisma schema the generated client came from. Set automatically by the
# docker entrypoint; helps the provider inference when DATABASE_URL is absent.
# PRISMA_SCHEMA_PATH="prisma/schema.sqlite.prisma"

# --- Authentication -------------------------------------------------------
# Sign/verify key for the `stl_session` JWT cookie. REQUIRED: minimum 16
# characters, unique, not a well-known default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-secret"

# Login identity. `APP_USERNAME` defaults to "admin" when unset.
APP_USERNAME="admin"

# Preferred: a bcrypt hash (cost 12), generated with:
#   npm run password:hash -- "your-password"
APP_PASSWORD_HASH=""

# Plaintext password — DEVELOPMENT ONLY. Starting with it set in production is
# a hard failure; prefer APP_PASSWORD_HASH above. Left empty on purpose: a
# template that shipped a usable demo password is exactly the forgeable default
# the audit removed from docker-compose.yml.
#   npm run password:hash -- "your-password"   -> APP_PASSWORD_HASH
APP_PASSWORD=""

# --- Query resilience -----------------------------------------------------
# Per-query timeout in ms (default 8000, clamped to 500..30000) used by
# src/lib/db-resilience.ts; a transient failure becomes a 503 + Retry-After
# instead of a 500.
# DB_QUERY_TIMEOUT_MS="8000"

# --- Backups (scripts/backup.ts, scripts/restore.ts) ----------------------
# Where snapshots and manifests go (default: <database dir or cwd>/backups, which
# is /data/backups inside the image so snapshots land on the persistent volume),
# and explicit paths for the Postgres client tools when they are not on PATH.
# Restores run through `psql -f`; there is no `pg_restore` step to configure.
# GID_BACKUP_DIR="./backups"
# PG_DUMP_PATH="/usr/bin/pg_dump"
# PSQL_PATH="/usr/bin/psql"

# --- Task time integrity --------------------------------------------------
# Worked time is computed server-side. Set to "true" only if you deliberately
# want to trust a client-supplied `startedAt` for new tasks (SEC-05).
# ALLOW_CLIENT_START_TIME="false"

# --- PDF export -----------------------------------------------------------
# Path to a Chromium/Chrome binary. The Docker image installs Chromium and sets
# this; locally it is detected automatically, and the export falls back to a
# downloadable HTML report when no browser is available.
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium-browser"

# --- Server ---------------------------------------------------------------
# The standalone server binds 0.0.0.0 and honours PORT (Coolify sets HOSTNAME /
# PORT automatically).
# PORT=3000
# NODE_ENV="development"
