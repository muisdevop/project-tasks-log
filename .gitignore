# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite db
dev.db

# archives and scratch files (PM-01: repository snapshots must never be committed)
*.zip
*.tar.gz
.tmp-*

# e2e (Playwright) scratch: database, storage state, reports
/e2e-playwright.db
/e2e-playwright.db-shm
/e2e-playwright.db-wal
/.playwright-e2e/
/.next-e2e/
/test-results/
/playwright-report/

# Generated artifacts: coverage report and the audit workbook export
/coverage/
/audit-report/

# Database snapshots written by `npm run db:backup` (MF-06)
/backups/

# Qoder/agent scratch: nested git worktrees hold full copies of this repo at an
# older commit. They must never be committed, linted, typechecked or built.
/.qoder/
